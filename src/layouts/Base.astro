---
import '../styles/global.css';
import { site } from '../site.config';
import { ui } from '../i18n/en';
import { url } from '../lib';

interface Props { title?: string; description?: string; lang?: string }
const { title, description = `${site.name}. ${site.role}. Healthcare, medical aesthetics, CRM, international campaigns and AI-powered digital products.`, lang = 'en' } = Astro.props;
const pageTitle = title ? `${title} · ${site.shortName}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  { label: ui.nav.home, href: url('') },
  { label: ui.nav.work, href: url('projects/') },
  { label: ui.nav.expertise, href: url('#expertise') },
  { label: ui.nav.about, href: url('about/') },
  { label: ui.nav.contact, href: url('contact/') },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f8f3f1" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    {(site.draft || !site.indexable) && <meta name="robots" content="noindex,nofollow" />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-3 focus:text-paper">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
      <div class="wrap flex items-center justify-between py-4">
        <a href={url('')} class="font-serif text-2xl leading-none tracking-tight">{site.shortName}</a>
        <nav aria-label="Main" class="hidden md:block">
          <ul class="flex gap-8 text-[13px] font-semibold uppercase tracking-[0.16em]">
            {nav.map((n) => <li><a class="hover:text-burgundy" href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
        <details class="group relative md:hidden">
          <summary class="cursor-pointer list-none text-[13px] font-semibold uppercase tracking-[0.16em] [&::-webkit-details-marker]:hidden">Menu</summary>
          <ul class="absolute right-0 top-9 w-56 border border-line bg-paper p-5 text-[13px] font-semibold uppercase tracking-[0.16em] shadow-xl">
            {nav.map((n) => <li><a class="block py-2 hover:text-burgundy" href={n.href}>{n.label}</a></li>)}
          </ul>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="mt-24 border-t border-line">
      <div class="wrap flex flex-col gap-6 py-10 text-sm text-muted md:flex-row md:items-center md:justify-between">
        <p>© {new Date().getFullYear()} {site.name}. {site.location}.</p>
        <p class="flex gap-6">
          <a class="link" href={site.linkedin} rel="noopener">LinkedIn</a>
          {site.email && <a class="link" href={`mailto:${site.email}`}>{site.email}</a>}
          <a class="link" href={url('contact/')}>{ui.nav.contact}</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
        els.forEach((e) => io.observe(e));
      })();
    </script>
  </body>
</html>
