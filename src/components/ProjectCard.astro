---
import type { Project } from '../data/types';
import { url } from '../lib';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
---
<a href={url(`projects/${project.slug}/`)} class="group reveal block focus-visible:outline-offset-8">
  <div class="relative flex aspect-[4/3] flex-col justify-between overflow-hidden bg-bordeaux p-7 text-paper md:p-9">
    {project.cover ? (
      <>
        <img src={url(`images/${project.cover}`)} alt="" decoding="async" class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.04]" />
        <div class="absolute inset-0 bg-gradient-to-t from-bordeaux via-bordeaux/35 to-bordeaux/60"></div>
      </>
    ) : (
      <div class="absolute inset-x-0 top-16 flex flex-col px-7 md:top-20 md:px-9" aria-hidden="true">
        {(project.cardWords || []).map((w) => <span class="display text-[clamp(1.8rem,3.4vw,3rem)] text-paper/20">{w}</span>)}
      </div>
    )}
    <div class="relative flex items-start justify-between text-[12px] font-semibold uppercase tracking-[0.18em]">
      <span>{String(index + 1).padStart(2, '0')}</span>
      <span>{project.period}</span>
    </div>
    <div class="relative">
      <h3 class="display text-5xl md:text-6xl">{project.title}</h3>
      <p class="mt-3 max-w-md text-[15px] leading-snug text-paper/90">{project.subtitle}</p>
    </div>
  </div>
  <div class="mt-4 grid gap-1 md:grid-cols-[1fr_auto] md:items-baseline md:gap-6">
    <div>
      <p class="text-sm font-semibold">{project.cardRole}</p>
      <p class="text-sm text-muted">{project.category.slice(0, 3).join(' · ')}</p>
    </div>
    <span class="text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">View case study →</span>
  </div>
</a>
