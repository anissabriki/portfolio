---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { ui } from '../i18n/en';
import { url } from '../lib';
---
<Base title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="wrap pb-24 pt-14 md:pt-24">
    <p class="eyebrow">Contact</p>
    <h1 class="display mt-6 max-w-[12ch] text-[clamp(3.2rem,9vw,9rem)]">Get <em class="text-burgundy">in touch.</em></h1>
    <p class="mt-8 max-w-xl text-lg text-muted">For roles in digital marketing, customer experience, healthcare and medical aesthetics marketing, or to talk about a project.</p>
    <ul class="mt-14 border-t border-line">
      {site.email && (
        <li class="grid gap-2 border-b border-line py-7 md:grid-cols-12"><span class="eyebrow md:col-span-3">Email</span><a class="link font-serif text-3xl md:col-span-9 md:text-4xl" href={`mailto:${site.email}`}>{site.email}</a></li>
      )}
      <li class="grid gap-2 border-b border-line py-7 md:grid-cols-12"><span class="eyebrow md:col-span-3">LinkedIn</span><a class="link font-serif text-3xl md:col-span-9 md:text-4xl" href={site.linkedin} rel="noopener">linkedin.com/in/anissasbriki ↗</a></li>
      <li class="grid gap-2 border-b border-line py-7 md:grid-cols-12"><span class="eyebrow md:col-span-3">Based in</span><span class="font-serif text-3xl md:col-span-9 md:text-4xl">{site.location}</span></li>
      {site.cvFile && (
        <li class="grid gap-2 border-b border-line py-7 md:grid-cols-12"><span class="eyebrow md:col-span-3">CV</span><a class="link font-serif text-3xl md:col-span-9 md:text-4xl" href={url(site.cvFile)} download>{ui.cta.cv} ↓</a></li>
      )}
    </ul>
  </section>
</Base>
