---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<Base title="Work" description="Selected work across healthcare, medical aesthetics, luxury and AI-powered digital products.">
  <section class="wrap pb-10 pt-14 md:pt-24">
    <p class="eyebrow">Work</p>
    <h1 class="display mt-6 text-[clamp(3rem,8vw,7.5rem)]">Seven projects, <em class="text-burgundy">one thread.</em></h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">Strategy, execution, digital experience, CRM, engagement, business growth.</p>
  </section>
  <section class="wrap grid gap-x-8 gap-y-14 py-10 md:grid-cols-2">
    {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
  </section>
</Base>
